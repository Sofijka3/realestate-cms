<!DOCTYPE html>
<html lang="<%= lang || 'pl' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title><%= t.favorites.pageTitle %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<header class="navbar">
  <div class="logo">🏠 RealEstateCMS</div>

  <button class="hamburger" onclick="toggleMenu()">☰</button>

  <div class="nav-wrapper" id="mobileMenu">
    
    <div class="lang-switch" style="display:flex; gap:10px; justify-content:center; margin-bottom: 10px;">
      <a href="/change-lang/pl" class="<%= (typeof lang !== 'undefined' && lang === 'pl') ? 'active' : '' %>" style="font-weight:bold;">PL</a>
      <a href="/change-lang/en" class="<%= (typeof lang !== 'undefined' && lang === 'en') ? 'active' : '' %>" style="font-weight:bold;">EN</a>
      <a href="/change-lang/ua" class="<%= (typeof lang !== 'undefined' && lang === 'ua') ? 'active' : '' %>" style="font-weight:bold;">UA</a>
    </div>

    <nav>
      <a href="/"><%= (typeof t !== 'undefined') ? t.nav.home : 'Home' %></a>
      <a href="/offers"><%= (typeof t !== 'undefined') ? t.nav.offers : 'Offers' %></a>
      <a href="/favorites" style="color: #e83e8c; font-weight: bold;">❤️ Ulubione</a>
      <a href="/about"><%= (typeof t !== 'undefined') ? t.nav.about : 'About' %></a>
      <a href="/contact"><%= (typeof t !== 'undefined') ? t.nav.contact : 'Contact' %></a>

      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn"><%= (typeof t !== 'undefined') ? t.nav.dashboard : 'Panel' %></a>
        <a href="/logout" class="btn-outline"><%= (typeof t !== 'undefined') ? t.nav.logout : 'Logout' %></a>
      <% } else { %>
        <a href="/login" class="btn"><%= (typeof t !== 'undefined') ? t.nav.login : 'Login' %></a>
        <% if (typeof t !== 'undefined' && t.nav.register) { %>
           <a href="/register" class="btn-outline"><%= t.nav.register %></a>
        <% } else { %>
           <a href="/register" class="btn-outline">Register</a>
        <% } %>
      <% } %>
    </nav>
  </div>
</header>

<script>
  function toggleMenu() {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('active');
  }
</script>

<main class="offers" style="min-height: 80vh;">
  
  <h1 style="text-align: center; margin: 30px 0;"><%= t.favorites.title %></h1>

  <% if (!offers || offers.length === 0) { %>
    <div style="text-align: center; padding: 50px;">
        <p style="font-size: 1.2rem; color: #666;"><%= t.favorites.empty %></p>
        <a href="/offers" class="btn" style="margin-top: 20px; display: inline-block;"><%= t.favorites.browseBtn %></a>
    </div>
  <% } else { %>
    <div class="offer-grid">
      <% offers.forEach(o => { %>
        <div class="offer-card" style="position: relative;">
          
          <a href="#" 
             class="fav-btn" 
             data-id="<%= o.id %>"
             style="position: absolute; top: 10px; right: 10px; z-index: 10; text-decoration: none; font-size: 1.5rem; filter: drop-shadow(0 0 2px rgba(255,255,255,0.8));" 
             title="<%= t.favorites.removeBtn %>">❤️</a>
          
          <% if (o.status === 'sold') { %>
             <div style="position: absolute; top: 10px; left: 10px; background: #dc3545; color: white; padding: 5px 10px; border-radius: 4px; font-weight: bold; z-index: 10; font-size: 0.8rem;">SPRZEDANE</div>
          <% } %>
          
          <% if (o.images && o.images.length) { %>
             <img src="<%= o.images[o.coverIndex || 0] %>" alt="">
          <% } else { %>
             <img src="/images/no-image.png" alt="">
          <% } %>
          
          <div class="offer-info">
            <h3><%= o.title %></h3>
            <p style="color: #666; font-size: 0.9rem;"><%= o.city %> — <%= o.area %> m²</p>
            <p class="price">
                <%= o.price.toLocaleString('pl-PL') %> <%= typeof settings !== 'undefined' ? settings.currency : 'PLN' %>
            </p>
            <a href="/offers/<%= o.id %>" class="btn-small" style="display:block; text-align:center; margin-top:10px;">
                <%= ui.buttons ? ui.buttons.details : 'Details' %>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<footer>
  <p>© 2025 RealEstateCMS</p>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.fav-btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = btn.dataset.id;
        try {
          const response = await fetch('/favorites/toggle-ajax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          const data = await response.json();
          
          if (data.success && !data.isAdded) {
             const card = btn.closest('.offer-card');
             if (card) {
                 // Анімація зникнення
                 card.style.transition = "all 0.5s ease";
                 card.style.opacity = "0";
                 card.style.transform = "scale(0.9)";
                 setTimeout(() => {
                     card.remove();
                     // Якщо карток не залишилось, перезавантажити сторінку
                     if (document.querySelectorAll('.offer-card').length === 0) location.reload();
                 }, 500);
             }
          }
        } catch (err) { console.error(err); }
      });
    });
  });
</script>

</body>
</html>