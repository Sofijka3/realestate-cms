<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title><%= t.auth.resetPageTitle %> | RealEstateCMS</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* --- Перемикач мов (Великий) --- */
    .lang-floating {
      position: absolute;
      top: 20px;
      right: 20px;
      display: flex;
      gap: 15px;
      background: rgba(255, 255, 255, 0.95);
      padding: 12px 25px; 
      border-radius: 30px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      z-index: 10;
    }
    .lang-floating a {
      text-decoration: none;
      color: #555;
      font-weight: bold;
      font-size: 16px;
      transition: color 0.3s;
    }
    .lang-floating a:hover {
      color: #007bff;
    }
    .lang-floating a.active {
      color: #0056b3;
      border-bottom: 2px solid #0056b3;
    }

    /* --- Стилі контейнера --- */
    .auth-container {
      max-width: 450px;
      width: 90%;
      padding: 40px;
      margin-top: 60px; /* Відступ від верху */
    }

    /* Заголовок */
    .auth-container h2 {
      font-size: 2rem;
      margin-bottom: 15px;
      color: #004080;
    }

    /* Опис */
    .auth-container p {
      font-size: 1.1rem;
      color: #555;
      margin-bottom: 25px;
      line-height: 1.5;
    }

    /* Поля вводу */
    .auth-container input {
      font-size: 1.1rem;
      padding: 15px;
      margin-bottom: 20px;
      border-radius: 8px;
      width: 100%;
      box-sizing: border-box; /* Щоб padding не ламав ширину */
    }

    /* Кнопка */
    .auth-container .btn {
      font-size: 1.2rem;
      padding: 15px;
      font-weight: bold;
      width: 100%;
      margin-top: 10px;
    }

    /* Посилання "Назад" */
    .info {
      margin-top: 25px;
      border-top: 1px solid #eee;
      padding-top: 20px;
    }
    .info a {
      color: #0066cc;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
    }

    /* Стилі повідомлень (успіх/помилка) */
    .message {
      background-color: #d4edda;
      color: #155724;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      margin-bottom: 20px;
      border: 1px solid #c3e6cb;
      font-size: 1rem;
    }
    
    .error {
      background-color: #f8d7da;
      color: #721c24;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      margin-bottom: 20px;
      border: 1px solid #f5c6cb;
      font-size: 1rem;
    }
  </style>
</head>
<body class="auth-page">

  <div class="lang-floating">
    <a href="/change-lang/pl" class="<%= lang === 'pl' ? 'active' : '' %>">PL</a>
    <a href="/change-lang/en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
    <a href="/change-lang/ua" class="<%= lang === 'ua' ? 'active' : '' %>">UA</a>
  </div>

  <div class="auth-container">
    <h2><%= t.auth.resetPageTitle %></h2>
    <p><%= t.auth.resetText %></p>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="message"><%= message %></div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/forgot-password">
      <input type="email" name="email" placeholder="<%= t.auth.emailPlaceholder %>" required>
      <button type="submit" class="btn"><%= t.auth.sendLinkBtn %></button>
    </form>

    <p class="info">
      <a href="/login">← <%= t.auth.backToLogin %></a>
    </p>
  </div>

</body>
</html>