<!DOCTYPE html>
<html lang="<%= lang || 'pl' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.dashboard.title %> | RealEstateCMS</title>
  <link rel="stylesheet" href="/style.css">
  
  <style>
    /* --- Стилі для Dashboard (HUB) --- */
    
    /* Центруємо весь блок на сторінці */
    .dashboard-container {
      display: flex;
      justify-content: center;
      margin: 40px auto;
      padding: 0 20px;
      min-height: 60vh;
    }

    /* Основний контент (Картка по центру) */
    .dashboard-content {
      width: 100%;
      max-width: 800px;
      background: white;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      text-align: center;
    }

    .dashboard-content h1 {
      margin-top: 0;
      color: #333;
      font-size: 2rem;
      margin-bottom: 10px;
    }

    .dashboard-content p {
      color: #666;
      margin-bottom: 40px;
      font-size: 1.1rem;
    }

    /* --- СІТКА КНОПОК --- */
    .dashboard-menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 25px;
      margin-bottom: 20px; /* Відступ знизу до кнопки */
    }

    .action-card {
      background: #f8f9fa;
      border: 1px solid #eee;
      padding: 30px 20px;
      border-radius: 12px;
      text-align: center;
      text-decoration: none;
      color: #333;
      transition: all 0.3s;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 160px;
    }

    .action-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      background: white;
      border-color: #007bff;
      color: #007bff;
    }

    .action-card .icon {
      font-size: 3rem;
      margin-bottom: 15px;
    }

    .action-card h3 {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 600;
    }

    /* --- АДАПТАЦІЯ ПІД ТЕЛЕФОН --- */
    @media (max-width: 768px) {
      .dashboard-container {
        padding: 0 15px;
        margin: 20px auto;
      }

      .dashboard-content {
        background: transparent;
        box-shadow: none;
        padding: 0;
      }
      
      .dashboard-menu-grid {
        grid-template-columns: 1fr; 
      }
      
      .action-card {
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        flex-direction: row;
        justify-content: flex-start;
        padding: 20px;
        min-height: auto;
        gap: 20px;
        text-align: left;
      }
      
      .action-card .icon {
        font-size: 2rem;
        margin-bottom: 0;
      }
    }
  </style>
</head>
<body>

<header class="navbar">
  <div class="logo">🏠 RealEstateCMS</div>
  <button class="hamburger" onclick="toggleMenu()">☰</button>
  <div class="nav-wrapper" id="mobileMenu">
    <div class="lang-switch" style="display:flex; gap:10px; justify-content:center; margin-bottom: 10px;">
      <a href="/change-lang/pl" class="<%= (typeof lang !== 'undefined' && lang === 'pl') ? 'active' : '' %>" style="font-weight:bold;">PL</a>
      <a href="/change-lang/en" class="<%= (typeof lang !== 'undefined' && lang === 'en') ? 'active' : '' %>" style="font-weight:bold;">EN</a>
      <a href="/change-lang/ua" class="<%= (typeof lang !== 'undefined' && lang === 'ua') ? 'active' : '' %>" style="font-weight:bold;">UA</a>
    </div>
    <nav>
      <a href="/"><%= (typeof t !== 'undefined') ? t.nav.home : 'Home' %></a>
      <a href="/offers"><%= (typeof t !== 'undefined') ? t.nav.offers : 'Offers' %></a>
      <a href="/favorites" style="color: #e83e8c;">❤️ Ulubione</a>
      <a href="/about"><%= (typeof t !== 'undefined') ? t.nav.about : 'About' %></a>
      <a href="/contact"><%= (typeof t !== 'undefined') ? t.nav.contact : 'Contact' %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn"><%= (typeof t !== 'undefined') ? t.nav.dashboard : 'Panel' %></a>
        <a href="/logout" class="btn-outline"><%= (typeof t !== 'undefined') ? t.nav.logout : 'Logout' %></a>
      <% } else { %>
        <a href="/login" class="btn"><%= (typeof t !== 'undefined') ? t.nav.login : 'Login' %></a>
        <% if (typeof t !== 'undefined' && t.nav.register) { %>
           <a href="/register" class="btn-outline"><%= t.nav.register %></a>
        <% } %>
      <% } %>
    </nav>
  </div>
</header>

<script>
  function toggleMenu() {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('active');
  }
</script>

<main class="dashboard">
  <div class="dashboard-container">

    <section class="dashboard-content">
      
      <h1><%= t.dashboard.welcome %>, <span style="color:#007bff"><%= user.username %></span>!</h1>
      <p><%= t.dashboard.description || "To jest Twój panel użytkownika. Wybierz działanie poniżej:" %></p>

      <div class="dashboard-menu-grid">
        
        <a href="/offers/add" class="action-card">
          <div class="icon">➕</div>
          <h3><%= t.dashboard.addOffer %></h3>
        </a>

        <a href="/my-offers" class="action-card">
          <div class="icon">📋</div>
          <h3><%= t.dashboard.myOffers %></h3>
        </a>

        <a href="/profile" class="action-card">
          <div class="icon">👤</div>
          <h3><%= t.dashboard.profile %></h3>
        </a>

        <% if (user && user.role === "admin") { %>
          <a href="/admin" class="action-card" style="border-color: #f39c12; color: #f39c12;">
            <div class="icon">🛠</div>
            <h3><%= t.dashboard.adminPanel %></h3>
          </a>
        <% } %>

      </div>

      <div style="text-align: center; margin-top: 40px;">
        <a href="/" class="btn-outline" style="padding: 12px 35px; display: inline-block; font-weight: bold;">← <%= t.dashboard.backHome %></a>
      </div>
      
    </section>

  </div>
</main>

<footer>
  <p>© 2025 RealEstateCMS</p>
</footer>

</body>
</html>