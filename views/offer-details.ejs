<!DOCTYPE html>
<html lang="<%= lang || 'pl' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title><%= offer.title %> | RealEstateCMS</title>
  <link rel="stylesheet" href="/style.css">
  
  <style>
    /* --- Стилі для сторінки оголошення --- */
    .offer-page {
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 20px;
    }

    .offer-details-card {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    /* Заголовок і статус */
    .offer-header {
      margin-bottom: 20px;
      border-bottom: 1px solid #eee;
      padding-bottom: 20px;
    }
    
    .offer-header h1 {
      margin: 0 0 10px 0;
      color: #333;
      font-size: 2rem;
    }

    .status-badge {
      padding: 5px 12px;
      border-radius: 5px;
      font-size: 0.8rem;
      font-weight: bold;
      vertical-align: middle;
      text-transform: uppercase;
      display: inline-block;
      margin-top: 5px;
    }

    /* Галерея */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 15px;
      margin-bottom: 30px;
    }

    .gallery img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 8px;
      transition: transform 0.3s;
      cursor: pointer;
    }

    .gallery img:hover {
      transform: scale(1.02);
    }

    /* Інформація */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
      background: #f8f9fa;
      padding: 20px;
      border-radius: 8px;
    }

    .info-item strong {
      display: block;
      color: #666;
      font-size: 0.9rem;
    }
    .info-item span {
      font-size: 1.1rem;
      font-weight: 600;
      color: #333;
    }

    .price-tag {
      font-size: 1.5rem;
      color: #28a745;
      font-weight: bold;
      margin: 15px 0;
    }

    /* Опис тексту */
    .description {
      line-height: 1.8;
      color: #444;
      font-size: 1.05rem;
      margin-bottom: 40px;
    }

    /* Форма контакту */
    .contact-box {
      background: #f1f8ff;
      padding: 25px;
      border-radius: 10px;
      border: 1px solid #cce5ff;
    }

    .contact-box h3 {
      margin-top: 0;
      color: #0056b3;
    }

    .contact-box input,
    .contact-box textarea {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 6px;
      box-sizing: border-box;
      font-family: inherit;
    }

    .contact-box button {
      background: #007bff;
      color: white;
      border: none;
      padding: 12px 25px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
    }

    /* Кнопки власника */
    .owner-actions {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #eee;
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    /* Адаптація */
    @media (max-width: 768px) {
      .offer-page {
        padding: 0 10px;
        margin: 20px auto;
      }
      .offer-details-card {
        padding: 20px;
      }
      .offer-header h1 {
        font-size: 1.5rem;
      }
      .gallery img {
        height: 200px;
      }
      .info-grid {
        grid-template-columns: 1fr 1fr; /* 2 колонки на телефоні */
      }
    }
  </style>
</head>
<body>

<header class="navbar">
  <div class="logo">🏠 RealEstateCMS</div>
  <button class="hamburger" onclick="toggleMenu()">☰</button>
  <div class="nav-wrapper" id="mobileMenu">
    <div class="lang-switch" style="display:flex; gap:10px; justify-content:center; margin-bottom: 10px;">
      <a href="/change-lang/pl" class="<%= (typeof lang !== 'undefined' && lang === 'pl') ? 'active' : '' %>" style="font-weight:bold;">PL</a>
      <a href="/change-lang/en" class="<%= (typeof lang !== 'undefined' && lang === 'en') ? 'active' : '' %>" style="font-weight:bold;">EN</a>
      <a href="/change-lang/ua" class="<%= (typeof lang !== 'undefined' && lang === 'ua') ? 'active' : '' %>" style="font-weight:bold;">UA</a>
    </div>
    <nav>
      <a href="/"><%= (typeof t !== 'undefined') ? t.nav.home : 'Home' %></a>
      <a href="/offers"><%= (typeof t !== 'undefined') ? t.nav.offers : 'Offers' %></a>
      <a href="/favorites" style="color: #e83e8c;">❤️ Ulubione</a>
      <a href="/about"><%= (typeof t !== 'undefined') ? t.nav.about : 'About' %></a>
      <a href="/contact"><%= (typeof t !== 'undefined') ? t.nav.contact : 'Contact' %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn"><%= (typeof t !== 'undefined') ? t.nav.dashboard : 'Panel' %></a>
        <a href="/logout" class="btn-outline"><%= (typeof t !== 'undefined') ? t.nav.logout : 'Logout' %></a>
      <% } else { %>
        <a href="/login" class="btn"><%= (typeof t !== 'undefined') ? t.nav.login : 'Login' %></a>
        <% if (typeof t !== 'undefined' && t.nav.register) { %>
           <a href="/register" class="btn-outline"><%= t.nav.register %></a>
        <% } %>
      <% } %>
    </nav>
  </div>
</header>

<script>
  function toggleMenu() {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('active');
  }
</script>

<main class="offer-page">
  <div class="offer-details-card">
    
    <div class="offer-header">
      <h1>
        <%= offer.title %> 
        <% if (offer.status === 'sold') { %> 
            <span class="status-badge" style="background: #dc3545; color: white;">SPRZEDANE</span> 
        <% } else if (offer.status === 'reserved') { %>
            <span class="status-badge" style="background: #ffc107; color: black;">REZERWACJA</span> 
        <% } %>
      </h1>
      <div class="price-tag">
        <%= offer.price.toLocaleString('pl-PL') %> PLN
      </div>
      <div style="color: #666;">
        📍 <%= offer.city %>, <%= offer.district %>
      </div>
    </div>

    <% if (offer.images?.length) { %>
      <div class="gallery">
        <% offer.images.forEach(img => { %>
          <img src="<%= img %>" alt="Ofertowe zdjęcie">
        <% }) %>
      </div>
    <% } %>

    <div class="info-grid">
      <div class="info-item">
        <strong>Typ nieruchomości</strong>
        <span><%= offer.type %></span>
      </div>
      <div class="info-item">
        <strong>Kategoria</strong>
        <span><%= offer.category %></span>
      </div>
      <div class="info-item">
        <strong>Powierzchnia</strong>
        <span><%= offer.area %> m²</span>
      </div>
      <div class="info-item">
        <strong>Liczba pokoi</strong>
        <span><%= offer.rooms %></span>
      </div>
      <div class="info-item">
        <strong>Data dodania</strong>
        <span><%= new Date(offer.createdAt).toLocaleDateString('pl-PL') %></span>
      </div>
    </div>

    <h3>Opis</h3>
    <div class="description">
      <p><%= offer.description %></p>
    </div>

    <% if (typeof user !== 'undefined' && user && offer.user !== user.email && offer.status !== 'sold') { %>
      <div class="contact-box">
        <h3>📩 Skontaktuj się z właścicielem</h3>
        <form action="/contact/<%= offer.id %>" method="POST">
          <label>Twoje imię:</label>
          <input type="text" name="name" value="<%= user.username %>" required maxlength="50">
          
          <label>Twój email:</label>
          <input type="email" name="email" value="<%= user.email %>" required maxlength="100">
          
          <label>Telefon:</label>
          <input type="text" name="phone" value="<%= user.phone %>" maxlength="20">
          
          <label>Wiadomość:</label>
          <textarea name="message" required placeholder="Napisz wiadomość..." maxlength="500"></textarea>
          
          <button type="submit">Wyślij wiadomość</button>
        </form>
      </div>
    <% } else if (offer.status === 'sold') { %>
      <div class="contact-box" style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24;">
          <h3 style="color: #721c24; margin:0;">⛔ To ogłoszenie jest już nieaktualne (sprzedane).</h3>
      </div>
    <% } else if (typeof user === 'undefined' || !user) { %>
      <div style="text-align: center; padding: 20px; background: #f9f9f9; border-radius: 8px;">
         <p class="subtitle">Aby skontaktować się z właścicielem — <a href="/login" style="color: #007bff; font-weight: bold;">zaloguj się</a>.</p>
      </div>
    <% } %>

    <% if (typeof user !== 'undefined' && user && offer.user === user.email) { %>
      <div class="owner-actions">
        <a href="/offers/edit/<%= offer.id %>" class="btn" style="background: #ffc107; color: black; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: bold;">✏️ Edytuj</a>
        
        <form action="/offers/delete/<%= offer.id %>" method="POST" style="display:inline-block;">
          <button class="btn-outline" onclick="return confirm('Czy na pewno chcesz usunąć to ogłoszenie?');" style="border: 1px solid #dc3545; color: #dc3545; background: transparent; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer;">🗑 Usuń</button>
        </form>
      </div>
    <% } %>

  </div>
</main>

<footer><p>© 2025 RealEstateCMS</p></footer>

</body>
</html>