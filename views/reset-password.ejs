<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Ustaw nowe hasło | RealEstateCMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">

  <div class="auth-container">
    <h2>Ustaw nowe hasło</h2>
    <p>Wprowadź nowe hasło dwukrotnie</p>

    <% if (message) { %>
      <p class="message"><%= message %></p>
    <% } %>

    <form method="POST" action="/reset-password/<%= token %>">
      <input type="password" name="password" placeholder="Nowe hasło" required>
      <input type="password" name="confirmPassword" placeholder="Potwierdź nowe hasło" required>
      <button type="submit" class="btn">Zmień hasło</button>
    </form>

    <p class="info">
      <a href="/login">Powrót do logowania</a>
    </p>
  </div>

</body>
</html>
