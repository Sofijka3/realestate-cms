<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Moje ogłoszenia | RealEstateCMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<header class="navbar">
  <div class="logo">🏠 RealEstateCMS</div>
  <nav>
    <a href="/">Home</a>
    <a href="/offers">Oferty</a>
    <a href="/dashboard" class="btn">Panel</a>
    <a href="/logout" class="btn-outline">Wyloguj</a>
  </nav>
</header>

<h2>Ustaw nowe hasło</h2>
<form action="/reset/<%= token %>" method="POST">
  <input type="password" name="password" placeholder="Nowe hasło" required>
  <button type="submit">Zapisz</button>
</form>
<p><%= message %></p>

<footer>
  <p>© 2025 RealEstateCMS — Wszystkie prawa zastrzeżone</p>
</footer>

</body>
</html>
