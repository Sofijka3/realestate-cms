<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Panel administracyjny</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .stats-box { display: flex; gap: 20px; margin: 20px 0; }
        .stat { background: #2e2e2e; padding: 20px; border-radius: 8px; flex: 1; text-align: center; color: #fff; }
        .log-box { background: #2e2e2e; padding: 15px; border-radius: 8px; margin-top: 20px; color: #fff; }
        .log-entry { border-bottom: 1px solid #444; padding: 6px 0; font-size: 14px; }
        canvas { background: #2e2e2e; border-radius: 8px; margin-top: 20px; }
        form label {
    color: #000;  /* чорний текст */
    font-weight: bold;
}
        label { margin-right: 10px; }
        select {
    padding: 4px;
    border-radius: 4px;
    background: #2e2e2e; /* темний фон, як у статистики */
    color: #fff;          /* білий текст */
    border: 1px solid #444;
}
    </style>
</head>
<body>
<div class="admin-container">

    <aside class="sidebar">
        <h2>Admin Panel</h2>
        <ul>
            <li class="active"><a href="/admin">📊 Dashboard</a></li>
            <li><a href="/admin/users">👤 Użytkownicy</a></li>
            <li><a href="/admin/offers">🏠 Ogłoszenia</a></li>
            <li class="active"><a href="/admin/settings">⚙️ Ustawienia serwisu</a></li>
            <li><a href="/logout">🚪 Wyloguj</a></li>
        </ul>
    </aside>

    <main class="content">

        <h1>Witaj, <%= user.username %>!</h1>
        <a href="/dashboard" class="btn-back">🔙 Powrót do profilu</a>

        <div class="stats-box">
            <div class="stat">
                <h2><%= totalUsers %></h2>
                <p>Użytkowników</p>
            </div>
            <div class="stat">
                <h2><%= totalOffers %></h2>
                <p>Ogłoszeń</p>
            </div>
        </div>

        <!-- Форма фільтру періоду -->
        <form id="filterForm" method="GET" action="/admin">
            <label for="period">Pokaż dane z okresu:</label>
            <select name="period" id="period" onchange="this.form.submit()">
                <option value="all" <%= period === 'all' ? 'selected' : '' %>>Wszystko</option>
                <option value="day" <%= period === 'day' ? 'selected' : '' %>>Ostatni dzień</option>
                <option value="week" <%= period === 'week' ? 'selected' : '' %>>Ostatni tydzień</option>
                <option value="month" <%= period === 'month' ? 'selected' : '' %>>Ostatni miesiąc</option>
            </select>
        </form>

        <!-- Canvas для графіка -->
        <canvas id="actionsChart" width="400" height="200"></canvas>

        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const defaultActions = { add: 0, edit: 0, delete: 0 };
            const actionCounts = <%- JSON.stringify(actionCounts || {}) %>;
            const actionCountsFilled = Object.assign({}, defaultActions, actionCounts);

            const ctx = document.getElementById('actionsChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['add', 'edit', 'delete'],
                    datasets: [{
                        label: 'Akcje użytkowników',
                        data: [
                            actionCountsFilled.add,
                            actionCountsFilled.edit,
                            actionCountsFilled.delete
                        ],
                        backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56'],
                        borderColor: '#fff',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { labels: { color: '#fff' } } },
                    scales: {
                        x: { ticks: { color: '#fff' } },
                        y: { ticks: { color: '#fff', beginAtZero: true } }
                    }
                }
            });
        });
        </script>

        <div class="log-box">
            <h3>Ostatni użytkownicy</h3>
            <% lastUsers.forEach(u => { %>
                <div class="log-entry">👤 <strong><%= u.username %></strong> — <%= u.email %></div>
            <% }) %>
        </div>

        <div class="log-box">
            <h3>Ostatnia aktywność</h3>
            <% lastLogs.forEach(l => { %>
                <div class="log-entry">
                    🕒 <%= new Date(l.time).toLocaleString("pl-PL") %> — <strong><%= l.user %></strong>: <%= l.action %>
                </div>
            <% }) %>
        </div>

    </main>
</div>
</body>
</html>
