<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title><%= t.auth.registerTitle %> | RealEstateCMS</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* --- Стиль для перемикача у кутку (Збільшений) --- */
    .lang-floating {
      position: absolute;
      top: 20px;
      right: 20px;
      display: flex;
      gap: 15px;
      background: rgba(255, 255, 255, 0.95);
      padding: 12px 25px; 
      border-radius: 30px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      z-index: 10;
    }
    .lang-floating a {
      text-decoration: none;
      color: #555;
      font-weight: bold;
      font-size: 16px; /* Більший шрифт */
      transition: color 0.3s;
    }
    .lang-floating a:hover {
      color: #007bff;
    }
    .lang-floating a.active {
      color: #0056b3;
      border-bottom: 2px solid #0056b3;
    }

    /* --- ПОКРАЩЕННЯ ВИДИМОСТІ (Великі шрифти для Реєстрації) --- */
    .auth-container {
      max-width: 450px;
      width: 90%;
      padding: 40px;
      margin-top: 60px; /* Відступ зверху, щоб не перекривало мови */
    }

    /* Заголовок */
    .auth-container h2 {
      font-size: 2rem;
      margin-bottom: 25px;
      color: #004080;
    }

    /* Поля вводу (Input) */
    .auth-container input {
      font-size: 1.1rem;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 8px;
    }

    /* Кнопка "Зареєструватися" */
    .auth-container .btn {
      font-size: 1.2rem;
      padding: 15px;
      font-weight: bold;
      margin-top: 15px;
    }

    /* Посилання */
    .auth-container p {
      font-size: 1.1rem;
      margin-top: 25px;
      line-height: 1.6;
    }
    
    .auth-container a {
      color: #0066cc;
      text-decoration: none;
      font-weight: 600;
    }

    /* Помилки */
    .error {
      color: #dc3545;
      background: #f8d7da;
      padding: 12px;
      border-radius: 8px;
      font-size: 1rem;
      margin: 20px 0;
      border: 1px solid #f5c6cb;
    }
  </style>
</head>
<body class="auth-page">

  <div class="lang-floating">
    <a href="/change-lang/pl" class="<%= lang === 'pl' ? 'active' : '' %>">PL</a>
    <a href="/change-lang/en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
    <a href="/change-lang/ua" class="<%= lang === 'ua' ? 'active' : '' %>">UA</a>
  </div>

  <div class="auth-container">
    <h2><%= t.auth.registerTitle %></h2>
    
    <form method="POST" action="/register">
      <input type="text" name="username" placeholder="<%= t.auth.inputLogin %>" required>
      <input type="email" name="email" placeholder="<%= t.auth.email %>" required>
      <input type="text" name="phone" placeholder="<%= t.auth.phone %>">
      <input type="password" name="password" placeholder="<%= t.auth.inputPassword %>" required>
      
      <button type="submit" class="btn"><%= t.auth.submitRegister %></button>
    </form>

    <% if (typeof message !== "undefined" && message) { %>
        <p class="error"><%= message %></p>
    <% } %>

    <p style="margin-top: 30px; border-top: 1px solid #eee; padding-top: 20px;">
      <%= t.auth.haveAccount %> <br>
      <a href="/login" style="font-size: 1.2rem;"><%= t.auth.loginLink %></a>
    </p>
  </div>
</body>
</html>